---
const { sideBarActiveItemID } = Astro.props;
const activeClass = "bg-base-300"; // For primary color replace with `active` class

const pathname = Astro.url.pathname;
const normalizedPath = pathname !== "/" && pathname.endsWith("/") ? pathname.slice(0, -1) : pathname;
const currentLocale = normalizedPath === "/ja" || normalizedPath.startsWith("/ja/")
  ? "ja"
  : normalizedPath === "/zh" || normalizedPath.startsWith("/zh/")
    ? "zh"
    : "en";

const localizedRoutes = {
  en: { home: "/", projects: "/projects", blog: "/blog/", cv: "/cv", contact: "/contact" },
  ja: { home: "/ja/", projects: "/ja/projects", blog: "/ja/blog/", cv: "/ja/cv", contact: "/contact" },
  zh: { home: "/zh/", projects: "/zh/projects", blog: "/zh/blog/", cv: "/zh/cv", contact: "/contact" },
};

const labels = {
  en: { home: "Home", projects: "Works", blog: "Notes", cv: "CV", contact: "Contact" },
  ja: { home: "ホーム", projects: "プロジェクト", blog: "ノート", cv: "履歴書", contact: "連絡先" },
  zh: { home: "主页", projects: "作品", blog: "笔记", cv: "简历", contact: "联系" },
};
const t = labels[currentLocale];

const routes = localizedRoutes[currentLocale];
---

<ul class="menu grow shrink menu-md overflow-y-auto space-y-1 px-4">
    <li>
        <a class="py-3 text-base flex items-center gap-3 transition-all duration-200 hover:pl-5 hover:text-primary outline-none focus:outline-none focus-visible:outline-none" id="home" href={routes.home}>
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 opacity-70">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
            </svg>
            <span class="font-medium tracking-wide">{t.home}</span>
        </a>
    </li>
    <li>
        <a class="py-3 text-base flex items-center gap-3 transition-all duration-200 hover:pl-5 hover:text-primary outline-none focus:outline-none focus-visible:outline-none" id="projects" href={routes.projects}>
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 opacity-70">
                <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 14.15v4.25c0 1.094-.787 2.036-1.872 2.18-2.087.277-4.216.42-6.378.42s-4.291-.143-6.378-.42c-1.085-.144-1.872-1.086-1.872-2.18v-4.25m16.5 0a2.18 2.18 0 00.75-1.661V8.706c0-1.081-.768-2.015-1.837-2.175a48.114 48.114 0 00-3.413-.387m4.5 8.006c-.194.165-.42.295-.673.38A23.978 23.978 0 0112 15.75c-2.648 0-5.195-.429-7.577-1.22a2.016 2.016 0 01-.673-.38m0 0A2.18 2.18 0 013 12.489V8.706c0-1.081.768-2.015 1.837-2.175a48.111 48.111 0 013.413-.387m7.5 0V5.25A2.25 2.25 0 0013.5 3h-3a2.25 2.25 0 00-2.25 2.25v.894m7.5 0a48.667 48.667 0 00-7.5 0M12 12.75h.008v.008H12v-.008z" />
            </svg>
            <span class="font-medium tracking-wide">{t.projects}</span>
        </a>
    </li>
    <li>
        <a class="py-3 text-base flex items-center gap-3 transition-all duration-200 hover:pl-5 hover:text-primary outline-none focus:outline-none focus-visible:outline-none" id="blog" href={routes.blog}>
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 opacity-70">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m3.75 9v6m3-3H9m1.5-12H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
            </svg>
            <span class="font-medium tracking-wide">{t.blog}</span>
        </a>
    </li>
    <li>
        <a class="py-3 text-base flex items-center gap-3 transition-all duration-200 hover:pl-5 hover:text-primary outline-none focus:outline-none focus-visible:outline-none" id="cv" href={routes.cv}>
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 opacity-70">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 9h3.75M15 12h3.75M15 15h3.75M4.5 19.5h15a2.25 2.25 0 002.25-2.25V6.75A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25v10.5A2.25 2.25 0 004.5 19.5zm6-10.125a1.875 1.875 0 11-3.75 0 1.875 1.875 0 013.75 0zm1.294 6.336a6.721 6.721 0 01-3.17.789 6.721 6.721 0 01-3.168-.789 3.376 3.376 0 016.338 0z" />
            </svg>
            <span class="font-medium tracking-wide">{t.cv}</span>
        </a>
    </li>
    <li>
        <a class="py-3 text-base flex items-center gap-3 transition-all duration-200 hover:pl-5 hover:text-primary outline-none focus:outline-none focus-visible:outline-none" id="contact" href={routes.contact}>
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 opacity-70">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
            </svg>
            <span class="font-medium tracking-wide">{t.contact}</span>
        </a>
    </li>
</ul>

<script define:vars={{ sideBarActiveItemID: sideBarActiveItemID, activeClass: activeClass }}>
const activeItemElem = document.getElementById(sideBarActiveItemID);
activeItemElem && activeItemElem.classList.add(activeClass);
</script>
