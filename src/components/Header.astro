---
const pathname = Astro.url.pathname;
const normalizedPath = pathname !== "/" && pathname.endsWith("/") ? pathname.slice(0, -1) : pathname;

const locales = [
  { code: "en", label: "English" },
  { code: "ja", label: "日本語" },
  { code: "zh", label: "中文" },
];

const currentLocale = normalizedPath === "/ja" || normalizedPath.startsWith("/ja/")
  ? "ja"
  : normalizedPath === "/zh" || normalizedPath.startsWith("/zh/")
    ? "zh"
    : "en";

const pagePath = normalizedPath === "/ja" || normalizedPath === "/zh"
  ? "/"
  : normalizedPath.replace(/^\/(ja|zh)/, "") || "/";

const cleanPath = pagePath.startsWith("/") ? pagePath : `/${pagePath}`;
const isBiostatPortfolio = cleanPath === "/biostatistics-portfolio";

const homeHref = currentLocale === "en" ? "/" : `/${currentLocale}/`;
const languageLinks = locales
  .map((locale) => {
    let href;
    let onClickStr = undefined;
    let isCurrent = locale.code === currentLocale;

    if (isBiostatPortfolio) {
      isCurrent = locale.code === "ja";
      href = "#";
      if (locale.code !== "ja") {
        onClickStr = "alert('このページは日本語のみ対応しています。'); return false;";
      } else {
        onClickStr = "event.preventDefault();";
      }
    } else {
      if (locale.code === "en") {
        href = cleanPath;
      } else {
        href = `/${locale.code}${cleanPath === "/" ? "/" : cleanPath}`;
      }
    }

    return {
      ...locale,
      isCurrent,
      href,
      onClickStr,
    };
  });
---

<div
  class="sticky lg:hidden top-0 z-30 flex h-16 w-full justify-center bg-opacity-90 backdrop-blur transition-all duration-100 bg-base-100 text-base-content shadow-sm"
>
  <div class="navbar">
    <div class="navbar-start">
      <label for="my-drawer" class="btn btn-square btn-ghost">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="inline-block w-5 h-5 stroke-current"
          ><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </label>
    </div>
    <div class="navbar-center">
      <a class="btn btn-ghost normal-case text-xl" href={homeHref}>Ziyin Wu</a>
    </div>
    <div class="navbar-end">
      <div class="flex items-center gap-1">
        {
          languageLinks.map((link) => (
            <a class:list={["btn btn-xs sm:btn-sm whitespace-nowrap", link.isCurrent ? "btn-active" : "btn-ghost"]} href={link.href} onclick={link.onClickStr}>
              {link.label}
            </a>
          ))
        }
      </div>
    </div>
  </div>
</div>

<div class="hidden lg:block fixed top-4 right-6 z-30">
  <div class="flex items-center gap-1 rounded-lg bg-base-100/80 p-1 backdrop-blur">
    {
      languageLinks.map((link) => (
        <a class:list={["btn btn-sm whitespace-nowrap", link.isCurrent ? "btn-active" : "btn-ghost"]} href={link.href} onclick={link.onClickStr}>
          {link.label}
        </a>
      ))
    }
  </div>
</div>
