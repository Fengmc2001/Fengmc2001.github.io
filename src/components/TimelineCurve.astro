---
type TimelineItem = {
  date: string;
  title: string;
  description?: string;
};

const {
  title,
  quote = "少年易老学难成",
  items,
} = Astro.props as {
  title: string;
  quote?: string;
  items: TimelineItem[];
};

const quoteChars = Array.from(quote);
const isCjkQuote = /[\u3000-\u9fff]/.test(quote);
---

<section class="journey my-10">
  <div class="journey-heading">
    <div class="journey-title">{title}</div>
    <div class:list={["journey-quote", isCjkQuote && "journey-quote-cjk"]} aria-label={quote}>
      {
        quoteChars.map((char) => (
          <span class:list={["quote-char", char === " " && "quote-space"]} aria-hidden="true">
            {char === " " ? "\u00A0" : char}
          </span>
        ))
      }
    </div>
  </div>

  <div class="timeline-panel" style={`--timeline-count: ${items.length};`}>
    <svg class="timeline-curve" viewBox="0 0 1000 120" preserveAspectRatio="none" aria-hidden="true">
      <path d="M 14 78 C 190 22, 360 102, 520 58 S 770 28, 986 72" />
    </svg>

    <div class="timeline-grid">
      {
        items.map((item) => (
          <article class="timeline-item">
            <div class="timeline-dot" aria-hidden="true"></div>
            <div class="timeline-label">
              <div class="timeline-date">{item.date}</div>
              <div class="timeline-title">{item.title}</div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .journey-heading {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    margin-bottom: 0.1rem;
  }

  .journey-quote {
    font-family: "Yu Mincho", "Hiragino Mincho ProN", "Songti SC", "STFangsong", "FangSong", serif;
    font-weight: 400;
    color: rgba(15, 23, 42, 0.78);
  }

  .journey-title {
    font-family: inherit;
    font-size: 1.75rem;
    font-weight: 700;
    line-height: 1.1;
    color: #000;
    text-align: center;
  }



  .journey-quote {
    font-size: 0.82rem;
    display: flex;
    flex-wrap: nowrap;
    justify-content: space-between;
    width: min(40rem, 72%);
    color: rgba(51, 65, 85, 0.5);
    text-align: center;
  }

  .journey-quote-cjk {
  width: min(30rem, 42%);
  font-size: 1.2rem;
  }

  .quote-char {
    display: inline-block;
  }

  .quote-space {
    width: 0.3rem;
  }

  .timeline-panel {
    position: relative;
    min-height: 9.5rem;
    overflow: visible;
  }

  .timeline-curve {
    position: absolute;
    top: 1.15rem;
    left: 0;
    width: 100%;
    height: 6.8rem;
    color: rgba(71, 85, 105, 0.18);
  }

  .timeline-curve path {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.2;
    stroke-linecap: round;
  }

  .timeline-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(var(--timeline-count), minmax(0, 1fr));
    min-height: 9.5rem;
  }

  .timeline-item {
    position: relative;
    min-width: 0;
  }

  .timeline-item:nth-child(1) {
    padding-top: 4.85rem;
  }

  .timeline-item:nth-child(2) {
    padding-top: 1.95rem;
  }

  .timeline-item:nth-child(3) {
    padding-top: 4.1rem;
  }

  .timeline-item:nth-child(4) {
    padding-top: 2.6rem;
  }

  .timeline-item:nth-child(n + 5) {
    padding-top: 3.3rem;
  }

  .timeline-dot {
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 9999px;
    background: rgba(51, 65, 85, 0.42);
    box-shadow:
      0 0 0 0.22rem rgba(148, 163, 184, 0.08),
      0 0 0 1px rgba(51, 65, 85, 0.08);
  }

  .timeline-label {
    margin-top: 0.45rem;
    margin-left: -0.1rem;
    max-width: 6.8rem;
    font-weight: 300;
    color: rgba(51, 65, 85, 0.66);
  }

  .timeline-date {
    font-size: 0.68rem;
    line-height: 1.1;
    letter-spacing: 0.03em;
  }

  .timeline-title {
    margin-top: 0.15rem;
    font-size: 0.74rem;
    line-height: 1.35;
  }

  @media (max-width: 768px) {
    .journey-heading {
      margin-bottom: 0.85rem;
    }

    .journey-quote {
      width: 100%;
      gap: 0.18rem;
      justify-content: center;
      flex-wrap: wrap;
    }

    .timeline-curve {
      display: none;
    }

    .timeline-panel {
      min-height: 0;
    }

    .timeline-grid {
      display: block;
      min-height: 0;
      border-left: 1px solid rgba(71, 85, 105, 0.16);
      margin-left: 0.2rem;
      padding-left: 1.25rem;
    }

    .timeline-item,
    .timeline-item:nth-child(n) {
      padding-top: 0;
      margin-bottom: 1rem;
    }

    .timeline-item:last-child {
      margin-bottom: 0;
    }

    .timeline-dot {
      position: absolute;
      left: -1.48rem;
      top: 0.25rem;
    }

    .timeline-label {
      margin-top: 0;
      max-width: none;
    }
  }
</style>
