---
import BaseHead from "../components/BaseHead.astro";
import NoteSideBar from "../components/notes/NoteSideBar.astro";
import TableOfContents from "../components/notes/TableOfContents.astro";
import { ViewTransitions } from "astro:transitions";
import { SITE_TITLE, SITE_DESCRIPTION, TRANSITION_API } from "../config";

const {
  image,
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  ogType,
  lang = "en",
  headings = []
} = Astro.props;

const path = Astro.url.pathname;
const locale = path.startsWith("/ja/") ? "ja" : path.startsWith("/zh/") ? "zh" : "en";
const blogHome = locale === "en" ? "/blog/" : `/${locale}/blog/`;
const backLabels = { en: "Back to Notes", ja: "ノートに戻る", zh: "返回笔记列表" };
---

<!doctype html>
<html lang={lang} data-theme="lofi">
  <head>
    <BaseHead title={title} description={description} image={image} ogType={ogType} />
    {TRANSITION_API && <ViewTransitions />}
  </head>
  <body class="bg-[#f8fafc] text-slate-900 font-sans antialiased min-h-screen selection:bg-slate-200">
    <div class="max-w-[1400px] mx-auto w-full px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col lg:flex-row items-start justify-center gap-8 relative pt-6 sm:pt-12 pb-20">
        
        <!-- Left: Toolbar (Hidden on small screens) -->
        <aside class="hidden lg:block w-16 shrink-0 sticky top-12 h-[calc(100vh-3rem)] pb-10">
          <NoteSideBar />
        </aside>

        <!-- Middle: Content Area -->
        <main class="w-full max-w-[840px] shrink-0 bg-white shadow-[0_2px_12px_-4px_rgba(0,0,0,0.05)] border border-slate-200/60 rounded-2xl p-6 sm:p-10 lg:p-14 relative z-10">
          <div class="lg:hidden mb-8 border-b border-slate-100 pb-4 flex items-center justify-between gap-3">
            <a href={blogHome} class="inline-flex items-center gap-2 text-sm font-medium text-slate-500 hover:text-slate-900 transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
              </svg>
              {backLabels[locale]}
            </a>
            <button
              type="button"
              data-translate-cycle
              aria-label="Translate (EN / JP / CN)"
              class="inline-flex items-center gap-1.5 px-3 h-8 rounded-full border border-slate-200 bg-white text-xs font-semibold text-slate-600 hover:border-slate-400 hover:text-slate-900 transition-colors"
            >
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="w-3.5 h-3.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="m10.5 21 5.25-11.25L21 21m-9-3h7.5M3 5.621a48.474 48.474 0 0 1 6-.371m0 0c1.12 0 2.233.038 3.334.114M9 5.25V3m3.334 2.364C11.176 10.658 7.69 15.08 3 17.502m9.334-12.138c.896.061 1.785.147 2.666.257m-4.589 8.495a18.023 18.023 0 0 1-3.827-5.802" />
              </svg>
              <span data-translate-label class="tabular-nums">EN</span>
            </button>
          </div>
          <slot />
        </main>

        <!-- Right: Table of Contents (Hidden on small screens) -->
        <aside class="hidden xl:block w-64 shrink-0 sticky top-12 h-[calc(100vh-3rem)] overflow-y-auto pb-10 custom-scrollbar">
          <TableOfContents headings={headings} />
        </aside>

      </div>
    </div>

    <!-- Google Translate Element + 翻译循环按钮的脚本。
         - 用 Google 官方 widget 作为翻译引擎（隐藏在屏幕外）。
         - 通过 googtrans cookie + 整页刷新触发翻译，最稳，跨浏览器一致。
         - 任意带 [data-translate-cycle] 的元素点击都会循环 EN→JP→CN。 -->
    <div id="google_translate_element" aria-hidden="true"></div>

    <script is:inline>
      function googleTranslateElementInit() {
        new google.translate.TranslateElement(
          {
            pageLanguage: "auto",
            includedLanguages: "en,ja,zh-CN",
            autoDisplay: false,
          },
          "google_translate_element"
        );
      }

      (function () {
        const codes = ["en", "ja", "zh-CN"];
        const labels = ["EN", "JP", "CN"];

        function readCookieIdx() {
          const m = document.cookie.match(/googtrans=\/auto\/([^;]+)/);
          if (!m) return -1;
          return codes.indexOf(decodeURIComponent(m[1]));
        }
        function localeFromPath() {
          const p = location.pathname;
          if (p.startsWith("/ja/")) return 1;
          if (p.startsWith("/zh/")) return 2;
          return 0;
        }
        function currentIdx() {
          const c = readCookieIdx();
          return c >= 0 ? c : localeFromPath();
        }
        function applyLabel() {
          const idx = currentIdx();
          document.querySelectorAll("[data-translate-label]").forEach((el) => {
            el.textContent = labels[idx];
          });
        }
        function setLang(idx) {
          // googtrans cookie 必须写在站点根 path，且不能 URL-encode 斜杠
          document.cookie = "googtrans=/auto/" + codes[idx] + "; path=/; max-age=31536000";
          location.reload();
        }
        function bind() {
          applyLabel();
          document.querySelectorAll("[data-translate-cycle]").forEach((btn) => {
            // Guard: Astro ViewTransitions 会保留 DOM 但重新执行 inline script，
            // 不加 guard 会重复绑定 → 第一次点击触发多次 reload，看起来像"卡住"。
            if (btn.dataset.translateBound === "1") return;
            btn.dataset.translateBound = "1";
            btn.addEventListener("click", (e) => {
              e.preventDefault();
              e.stopPropagation();
              const next = (currentIdx() + 1) % codes.length;
              setLang(next);
            });
          });
        }
        // Astro ViewTransitions：站内导航不刷新整页，需要监听 page-load 事件
        // 才能重新绑定按钮（DOMContentLoaded 在站内导航时不会再触发）。
        bind();
        document.addEventListener("DOMContentLoaded", bind);
        document.addEventListener("astro:page-load", bind);
      })();
    </script>
    <script is:inline async src="https://translate.google.com/translate_a/element.js?cb=googleTranslateElementInit"></script>

    <style is:global>
      /* 把 Google Translate Element 移出可视区域，但保留在 DOM 中（widget 必须能挂载） */
      #google_translate_element {
        position: absolute !important;
        left: -9999px !important;
        top: -9999px !important;
        width: 1px;
        height: 1px;
        overflow: hidden;
      }
      /* 隐藏 Google 注入的顶部 banner，避免页面下移 */
      .goog-te-banner-frame.skiptranslate { display: none !important; }
      body { top: 0 !important; }
      /* 隐藏 hover 时的"原文/翻译"工具提示 */
      .goog-tooltip, .goog-tooltip:hover { display: none !important; }
      .goog-text-highlight {
        background: transparent !important;
        box-shadow: none !important;
      }
    </style>

    <style is:global>
      /* Code blocks and syntax highlighting */
      .prose pre {
        background-color: #0f172a !important; /* slate-900 */
        color: #f8fafc !important; /* slate-50 */
        border-radius: 0.75rem;
        padding: 1.25rem 1.5rem;
        overflow-x: auto;
        box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.1);
        margin-top: 1.5em;
        margin-bottom: 1.5em;
      }
      .prose code {
        background-color: #f1f5f9; /* slate-100 */
        padding: 0.2em 0.4em;
        border-radius: 0.375rem;
        font-size: 0.875em;
        font-weight: 500;
        color: #334155; /* slate-700 */
        border: 1px solid #e2e8f0;
      }
      .prose pre code {
        background-color: transparent;
        padding: 0;
        color: inherit;
        border: none;
        font-size: 0.9em;
      }
      
      /* Blockquotes */
      .prose blockquote {
        border-left-width: 4px;
        border-left-color: #cbd5e1; /* slate-300 */
        font-style: italic;
        color: #475569; /* slate-600 */
        background-color: #f8fafc; /* slate-50 */
        padding: 0.75rem 1.25rem;
        margin-left: 0;
        margin-right: 0;
        border-radius: 0 0.5rem 0.5rem 0;
        box-shadow: inset 0 0 0 1px #f1f5f9;
      }
      .prose blockquote p:first-of-type::before {
        content: none;
      }
      .prose blockquote p:last-of-type::after {
        content: none;
      }
      
      /* Tables */
      .prose table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 2em;
        margin-bottom: 2em;
        font-size: 0.95em;
      }
      .prose th, .prose td {
        border: 1px solid #e2e8f0; /* slate-200 */
        padding: 0.75rem 1rem;
      }
      .prose th {
        background-color: #f8fafc; /* slate-50 */
        font-weight: 600;
        text-align: left;
        color: #334155;
      }
      .prose tbody tr:nth-child(even) {
        background-color: #f8fafc;
      }
      
      /* Hide standard prose backticks if they are injected via ::before/::after */
      .prose code::before, .prose code::after {
        content: none !important;
      }
      
      /* Typography tweaks */
      .prose {
        font-size: 0.9375rem;
        line-height: 1.8;
        color: #334155;
      }
      .prose h1, .prose h2, .prose h3, .prose h4 {
        color: #0f172a;
        scroll-margin-top: 6rem;
      }
      .prose h1 { font-size: 2.25em; margin-top: 0; margin-bottom: 0.888em; line-height: 1.111; }
      .prose h2 { font-size: 1.6em; margin-top: 2em; margin-bottom: 1em; line-height: 1.333; font-weight: 700; border-bottom: 1px solid #f1f5f9; padding-bottom: 0.3em; }
      .prose h3 { font-size: 1.3em; margin-top: 1.6em; margin-bottom: 0.6em; line-height: 1.6; font-weight: 600; }
      .prose p { margin-bottom: 1.25em; margin-top: 1.25em; }
      
      /* Lists */
      .prose ul, .prose ol {
        margin-top: 1em;
        margin-bottom: 1em;
        padding-left: 1.5em;
      }
      .prose li {
        margin-top: 0.25em;
        margin-bottom: 0.25em;
      }
      
      /* Link colors */
      .prose a {
        color: #2563eb; /* blue-600 */
        text-decoration: none;
        border-bottom: 1px solid transparent;
        transition: border-color 0.2s ease;
      }
      .prose a:hover {
        border-color: #2563eb;
      }

      /* Keep article body images readable without dominating the page */
      .prose-content img {
        display: block;
        width: auto;
        max-width: min(100%, 34rem);
        max-height: 28rem;
        object-fit: contain;
        margin: 1.75rem auto;
        border-radius: 0.75rem;
        border: 1px solid #e2e8f0;
        box-shadow: 0 8px 24px -18px rgba(15, 23, 42, 0.35);
      }

      .prose-content p > img:only-child {
        margin-top: 0.5rem;
        margin-bottom: 0.5rem;
      }

      @media (max-width: 640px) {
        .prose-content img {
          max-width: 100%;
          max-height: none;
        }
      }

      /* KaTeX formulas overflow handling */
      .katex-display {
        overflow-x: auto;
        overflow-y: hidden;
        padding-top: 0.5em;
        padding-bottom: 0.5em;
      }

      /* Custom scrollbar for sidebars */
      .custom-scrollbar::-webkit-scrollbar {
        width: 4px;
      }
      .custom-scrollbar::-webkit-scrollbar-track {
        background: transparent;
      }
      .custom-scrollbar::-webkit-scrollbar-thumb {
        background: #cbd5e1;
        border-radius: 4px;
      }
      .custom-scrollbar::-webkit-scrollbar-thumb:hover {
        background: #94a3b8;
      }
    </style>
  </body>
</html>
