---
import BaseHead from "../components/BaseHead.astro";
import NoteSideBar from "../components/notes/NoteSideBar.astro";
import TableOfContents from "../components/notes/TableOfContents.astro";
import { ViewTransitions } from "astro:transitions";
import { SITE_TITLE, SITE_DESCRIPTION, TRANSITION_API } from "../config";

const {
  image,
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  ogType,
  lang = "en",
  headings = []
} = Astro.props;
---

<!doctype html>
<html lang={lang} data-theme="lofi">
  <head>
    <BaseHead title={title} description={description} image={image} ogType={ogType} />
    {TRANSITION_API && <ViewTransitions />}
    <!-- KaTeX CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css" integrity="sha384-n8MVd4RsEOPaLzO1iOdEEig4Zwq087wS4B4AcmFuiI2wPujU0UIti286mA1BqTjE" crossorigin="anonymous">
  </head>
  <body class="bg-[#f8fafc] text-slate-900 font-sans antialiased min-h-screen selection:bg-slate-200">
    <div class="max-w-[1400px] mx-auto w-full px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col lg:flex-row items-start justify-center gap-8 relative pt-6 sm:pt-12 pb-20">
        
        <!-- Left: Toolbar (Hidden on small screens) -->
        <aside class="hidden lg:block w-16 shrink-0 sticky top-12 h-[calc(100vh-3rem)] pb-10">
          <NoteSideBar />
        </aside>

        <!-- Middle: Content Area -->
        <main class="w-full max-w-[840px] shrink-0 bg-white shadow-[0_2px_12px_-4px_rgba(0,0,0,0.05)] border border-slate-200/60 rounded-2xl p-6 sm:p-10 lg:p-14 relative z-10">
          <div class="lg:hidden mb-8 border-b border-slate-100 pb-4">
            <a href="/blog/" class="inline-flex items-center gap-2 text-sm font-medium text-slate-500 hover:text-slate-900 transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
              </svg>
              Back to Notes
            </a>
          </div>
          <slot />
        </main>

        <!-- Right: Table of Contents (Hidden on small screens) -->
        <aside class="hidden xl:block w-64 shrink-0 sticky top-12 h-[calc(100vh-3rem)] overflow-y-auto pb-10 custom-scrollbar">
          <TableOfContents headings={headings} />
        </aside>

      </div>
    </div>
    
    <style is:global>
      /* Code blocks and syntax highlighting */
      .prose pre {
        background-color: #0f172a !important; /* slate-900 */
        color: #f8fafc !important; /* slate-50 */
        border-radius: 0.75rem;
        padding: 1.25rem 1.5rem;
        overflow-x: auto;
        box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.1);
        margin-top: 1.5em;
        margin-bottom: 1.5em;
      }
      .prose code {
        background-color: #f1f5f9; /* slate-100 */
        padding: 0.2em 0.4em;
        border-radius: 0.375rem;
        font-size: 0.875em;
        font-weight: 500;
        color: #334155; /* slate-700 */
        border: 1px solid #e2e8f0;
      }
      .prose pre code {
        background-color: transparent;
        padding: 0;
        color: inherit;
        border: none;
        font-size: 0.9em;
      }
      
      /* Blockquotes */
      .prose blockquote {
        border-left-width: 4px;
        border-left-color: #cbd5e1; /* slate-300 */
        font-style: italic;
        color: #475569; /* slate-600 */
        background-color: #f8fafc; /* slate-50 */
        padding: 0.75rem 1.25rem;
        margin-left: 0;
        margin-right: 0;
        border-radius: 0 0.5rem 0.5rem 0;
        box-shadow: inset 0 0 0 1px #f1f5f9;
      }
      .prose blockquote p:first-of-type::before {
        content: none;
      }
      .prose blockquote p:last-of-type::after {
        content: none;
      }
      
      /* Tables */
      .prose table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 2em;
        margin-bottom: 2em;
        font-size: 0.95em;
      }
      .prose th, .prose td {
        border: 1px solid #e2e8f0; /* slate-200 */
        padding: 0.75rem 1rem;
      }
      .prose th {
        background-color: #f8fafc; /* slate-50 */
        font-weight: 600;
        text-align: left;
        color: #334155;
      }
      .prose tbody tr:nth-child(even) {
        background-color: #f8fafc;
      }
      
      /* Hide standard prose backticks if they are injected via ::before/::after */
      .prose code::before, .prose code::after {
        content: none !important;
      }
      
      /* Typography tweaks */
      .prose {
        line-height: 1.8;
        color: #334155;
      }
      .prose h1, .prose h2, .prose h3, .prose h4 {
        color: #0f172a;
        scroll-margin-top: 6rem;
      }
      .prose h1 { font-size: 2.25em; margin-top: 0; margin-bottom: 0.888em; line-height: 1.111; }
      .prose h2 { font-size: 1.6em; margin-top: 2em; margin-bottom: 1em; line-height: 1.333; font-weight: 700; border-bottom: 1px solid #f1f5f9; padding-bottom: 0.3em; }
      .prose h3 { font-size: 1.3em; margin-top: 1.6em; margin-bottom: 0.6em; line-height: 1.6; font-weight: 600; }
      .prose p { margin-bottom: 1.25em; margin-top: 1.25em; }
      
      /* Lists */
      .prose ul, .prose ol {
        margin-top: 1em;
        margin-bottom: 1em;
        padding-left: 1.5em;
      }
      .prose li {
        margin-top: 0.25em;
        margin-bottom: 0.25em;
      }
      
      /* Link colors */
      .prose a {
        color: #2563eb; /* blue-600 */
        text-decoration: none;
        border-bottom: 1px solid transparent;
        transition: border-color 0.2s ease;
      }
      .prose a:hover {
        border-color: #2563eb;
      }

      /* KaTeX formulas overflow handling */
      .katex-display {
        overflow-x: auto;
        overflow-y: hidden;
        padding-top: 0.5em;
        padding-bottom: 0.5em;
      }

      /* Custom scrollbar for sidebars */
      .custom-scrollbar::-webkit-scrollbar {
        width: 4px;
      }
      .custom-scrollbar::-webkit-scrollbar-track {
        background: transparent;
      }
      .custom-scrollbar::-webkit-scrollbar-thumb {
        background: #cbd5e1;
        border-radius: 4px;
      }
      .custom-scrollbar::-webkit-scrollbar-thumb:hover {
        background: #94a3b8;
      }
    </style>
  </body>
</html>
