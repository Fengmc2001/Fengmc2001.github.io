---
import { type BlogSchema } from "../content/config";
import AcademicNoteLayout from "./AcademicNoteLayout.astro";
import dayjs from "dayjs";
import localizedFormat from "dayjs/plugin/localizedFormat";
import { Image } from "astro:assets";

export interface Props extends BlogSchema {
  headings?: any[];
}

const { title, description, pubDate, updatedDate, heroImage, badge, tags = [], headings = [] } = Astro.props;
dayjs.extend(localizedFormat);
const displayDate = dayjs(pubDate).format("ll")
---

<AcademicNoteLayout title={title} description={description} image={heroImage} ogType="article" headings={headings}>
  <article class="prose prose-slate prose-lg max-w-none w-full pb-20">
    {heroImage && <Image width={840} height={472} format="webp" src={heroImage} alt={title} class="w-full mb-8 rounded-xl shadow-sm object-cover border border-slate-100" />}
    
    <header class="mb-10 pb-6 border-b border-slate-200">
      <h1 class="title text-4xl sm:text-5xl font-bold tracking-tight text-slate-900 mb-6 leading-tight">{title}</h1>
      
      <div class="flex flex-wrap items-center gap-4 text-slate-500 text-sm sm:text-base">
        {pubDate && <time class="flex items-center gap-1.5 font-medium">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" />
          </svg>
          {displayDate}
        </time>}
        
        {updatedDate && (
          <span class="flex items-center gap-1 italic border-l border-slate-300 pl-4">
            Updated: <time>{updatedDate}</time>
          </span>
        )}

        {badge && <span class="badge badge-secondary badge-outline px-3 py-1 ml-auto font-medium">{badge}</span>}
      </div>

      {tags && tags.length > 0 && (
        <div class="flex flex-wrap gap-2 mt-6">
          {tags.map((tag) => (
            <a href={`/blog/tag/${tag}`} class="bg-slate-100 text-slate-600 hover:bg-slate-200 hover:text-slate-900 transition-colors px-3 py-1 rounded-full text-sm font-medium no-underline">
              #{tag}
            </a>
          ))}
        </div>
      )}

    </header>

    <div class="prose-content">
      <slot />
    </div>
  </article>

  <!-- Hidden Google Translate Element：仅作为翻译引擎的隐藏后端。
       UI 由下面右上角的悬浮按钮控制，点击循环切换 EN → JP → CN。 -->
  <div id="google_translate_element" aria-hidden="true"></div>

  <button
    id="translate-cycle-btn"
    type="button"
    aria-label="Translate this article"
    class="fixed top-20 right-6 z-40 hidden md:flex items-center gap-1.5 h-9 px-3 rounded-full bg-white/90 backdrop-blur border border-slate-200 shadow-sm text-slate-600 text-sm font-medium hover:bg-white hover:border-slate-300 hover:text-slate-900 transition"
  >
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
      <path stroke-linecap="round" stroke-linejoin="round" d="m10.5 21 5.25-11.25L21 21m-9-3h7.5M3 5.621a48.474 48.474 0 0 1 6-.371m0 0c1.12 0 2.233.038 3.334.114M9 5.25V3m3.334 2.364C11.176 10.658 7.69 15.08 3 17.502m9.334-12.138c.896.061 1.785.147 2.666.257m-4.589 8.495a18.023 18.023 0 0 1-3.827-5.802" />
    </svg>
    <span id="translate-cycle-label">EN</span>
  </button>

  <button
    id="translate-cycle-btn-mobile"
    type="button"
    aria-label="Translate this article"
    class="md:hidden fixed bottom-6 right-6 z-40 flex items-center gap-1 h-10 px-3 rounded-full bg-slate-900/90 backdrop-blur text-white text-sm font-medium shadow-lg active:scale-95 transition"
  >
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
      <path stroke-linecap="round" stroke-linejoin="round" d="m10.5 21 5.25-11.25L21 21m-9-3h7.5M3 5.621a48.474 48.474 0 0 1 6-.371m0 0c1.12 0 2.233.038 3.334.114M9 5.25V3m3.334 2.364C11.176 10.658 7.69 15.08 3 17.502m9.334-12.138c.896.061 1.785.147 2.666.257m-4.589 8.495a18.023 18.023 0 0 1-3.827-5.802" />
    </svg>
    <span id="translate-cycle-label-mobile">EN</span>
  </button>

  <script is:inline>
    function googleTranslateElementInit() {
      new google.translate.TranslateElement(
        {
          pageLanguage: "auto",
          includedLanguages: "en,ja,zh-CN",
          layout: google.translate.TranslateElement.InlineLayout.SIMPLE,
          autoDisplay: false,
        },
        "google_translate_element"
      );
    }

    (function () {
      const codes = ["en", "ja", "zh-CN"];
      const labels = ["EN", "JP", "CN"];

      function detectInitial() {
        const p = location.pathname;
        if (p.startsWith("/ja/")) return 1;
        if (p.startsWith("/zh/")) return 2;
        return 0;
      }
      let idx = detectInitial();

      function setLabel(text) {
        const a = document.getElementById("translate-cycle-label");
        const b = document.getElementById("translate-cycle-label-mobile");
        if (a) a.textContent = text;
        if (b) b.textContent = text;
      }

      function applyLang(targetIdx) {
        function go(retries) {
          const sel = document.querySelector("#google_translate_element select.goog-te-combo");
          if (!sel) {
            if (retries > 0) return setTimeout(() => go(retries - 1), 120);
            return;
          }
          sel.value = codes[targetIdx];
          sel.dispatchEvent(new Event("change"));
        }
        go(40);
      }

      function bind() {
        setLabel(labels[idx]);
        function onClick() {
          idx = (idx + 1) % codes.length;
          setLabel(labels[idx]);
          applyLang(idx);
        }
        document.getElementById("translate-cycle-btn")?.addEventListener("click", onClick);
        document.getElementById("translate-cycle-btn-mobile")?.addEventListener("click", onClick);
      }
      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", bind);
      } else {
        bind();
      }
    })();
  </script>
  <script is:inline async src="https://translate.google.com/translate_a/element.js?cb=googleTranslateElementInit"></script>

  <style is:global>
    /* 完全隐藏 Google 注入的所有 UI（顶栏、下拉、tooltip） */
    #google_translate_element { display: none !important; }
    .goog-te-banner-frame.skiptranslate { display: none !important; }
    body { top: 0 !important; }
    .goog-tooltip, .goog-tooltip:hover { display: none !important; }
    .goog-text-highlight {
      background: transparent !important;
      box-shadow: none !important;
    }
  </style>
</AcademicNoteLayout>
