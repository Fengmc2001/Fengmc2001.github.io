---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import { getCollection } from "astro:content";
import createSlug from "../lib/createSlug"

const posts = (await getCollection("blog")).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const last_posts = posts.slice(0, 3);
---

<BaseLayout sideBarActiveItemID="home">
  <div class="pb-12 mt-5">
    <div class="text-xl py-1">Personal Academic Portfolio</div>
    <div class="text-5xl font-bold">I'm Ziyin Wu</div>
    <div class="text-3xl py-3 font-bold">
      Information Engineering undergraduate interested in AI,<br />
      biostatistics, and data science
    </div>
    <div class="py-2 space-y-4 text-lg leading-relaxed">
      <p>
        I am an undergraduate student in the Department of Information Engineering at Tokyo University of Science.
      </p>
      <p>
        My interests center on AI and machine learning, with additional focus on biostatistics, causal inference, real-world data analysis, and reproducible scientific computing.
      </p>
      <p>
        My current undergraduate research examines multilingual consistency in unlearning for large multimodal models.
      </p>
      <p>
        This website collects my academic profile, selected projects, research notes, and CV.
      </p>
    </div>
    <div class="mt-8">
      <a class="btn" href="/projects">View works</a>
      <a href="/cv" class="btn btn-outline ml-5">View CV</a>
    </div>
  </div>

  <div>
    <div class="text-3xl w-full font-bold mb-2">Selected works</div>
  </div>

  <HorizontalCard
    title="Multilingual MLLM Unlearning"
    img="/analysis.svg"
    desc="Undergraduate research on cross-lingual consistency and trustworthy forgetting behavior in large multimodal models."
    url="/projects"
    target="_self"
    badge="AI"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Biostatistics & Causal Inference"
    img="/research.svg"
    desc="Research interests in target trial emulation, causal inference, real-world data, and clinical research methodology."
    url="/projects"
    target="_self"
    badge="Research"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Statistical Programming & Data Analysis"
    img="/writing.svg"
    desc="Projects and practice using Python, R, SAS, SQL, and reproducible reporting workflows."
    url="/projects"
    target="_self"
    badge="Data"
  />

  <div>
    <div class="text-3xl w-full font-bold mb-5 mt-10">Latest notes</div>
  </div>

  {
    last_posts.map((post) => (
      <>
        <HorizontalCard
          title={post.data.title}
          img={post.data.heroImage}
          desc={post.data.description}
          url={"/blog/" + createSlug(post.data.title, post.slug)}
          target="_self"
          badge={post.data.badge}
        />
        <div class="divider my-0" />
      </>
    ))
  }
</BaseLayout>
