---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HorizontalCard from "../../components/HorizontalCard.astro";
---

<BaseLayout
  title="研究・制作内容"
  description="生物統計学、臨床研究方法論、再現可能なデータ解析に関する研究・制作内容です。"
  sideBarActiveItemID="projects"
  lang="ja"
>
  <div>
    <div class="text-3xl w-full font-bold mb-5">研究とデータ解析</div>
  </div>

  <HorizontalCard
    title="生物統計学に関する研究計画"
    img="/research.svg"
    desc="研究背景、臨床的意義、方法、期待される貢献、参考文献を整理するための研究計画項目です。"
    url="#"
    badge="研究"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="臨床データ解析ワークフロー"
    img="/analysis.svg"
    desc="統計プログラミング、データクリーニング、モデリング、可視化、再現可能な報告を扱うプロジェクト項目です。"
    url="#"
    badge="データ"
  />

  <div>
    <div class="text-3xl w-full font-bold mb-5 mt-10">学術的な文章作成とコミュニケーション</div>
  </div>

  <HorizontalCard
    title="学術文書・研究計画書"
    img="/writing.svg"
    desc="研究上の問い、方法、根拠、議論を明確に整理するための文章サンプルです。"
    url="#"
    badge="文章"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="文献・参考資料ノート"
    img="/writing.svg"
    desc="研究論文、統計的方法論、生物医学的エビデンスに関する構造化されたノートです。"
    url="#"
    badge="ノート"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="ポートフォリオの今後の展開"
    img="/analysis.svg"
    desc="公開コード、データセット、インタラクティブな解析レポートなどを今後追加するための項目です。"
    url="#"
  />
</BaseLayout>
