---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HorizontalCard from "../../components/HorizontalCard.astro";
import { getCollection } from "astro:content";
import createSlug from "../../lib/createSlug";

const posts = (await getCollection("blog")).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const lastPosts = posts.slice(0, 3);

const noteCopy: Record<string, { title: string; description: string; badge?: string }> = {
  "reproducible-analysis": {
    title: "再現可能なデータ解析のチェックリスト",
    description: "解析コード、表、図、報告書を検証可能な形で整理するための実践的なメモです。",
    badge: "データ解析",
  },
  "academic-writing": {
    title: "研究基盤としての学術的文章作成",
    description: "アウトライン、引用管理、LaTeX を用いて研究上の思考と修正過程を整理するための短い考察です。",
    badge: "学術文書",
  },
  "research-proposal": {
    title: "生物統計学の研究計画書をどのように構成するか",
    description: "臨床上の問いを、研究デザイン、仮定、解析計画、期待される貢献へと接続するためのメモです。",
    badge: "研究計画",
  },
};
---

<BaseLayout
  title="Ziyin Wu | AI・生物統計学・データサイエンス"
  description="東京理科大学の情報工学科に在籍する呉 子吟のアカデミック・ポートフォリオです。"
  sideBarActiveItemID="home"
  lang="ja"
>
  <div class="pb-12 mt-5">
    <div class="text-xl py-1">アカデミック・ポートフォリオ</div>
    <div class="text-5xl font-bold">呉 子吟 / Ziyin Wu</div>
    <div class="text-3xl py-3 font-bold">
      AI・生物統計学・データサイエンスに関心を持つ、<br />
      情報工学専攻の学部生
    </div>
    <div class="py-2 space-y-4 text-lg leading-relaxed">
      <p>
        東京理科大学 工学部 情報工学科に在籍している。
      </p>
      <p>
        AI・機械学習を中心に、生物統計学、因果推論、リアルワールドデータ解析、再現可能なデータ解析にも関心がある。
      </p>
      <p>
        現在の卒業研究では、多言語大規模マルチモーダルモデルにおける忘却の多言語一貫性を扱っている。
      </p>
      <p>
        本サイトでは、研究関心、プロジェクト、学習ノート、CV を整理している。
      </p>
    </div>
    <div class="mt-8">
      <a class="btn" href="/ja/projects">研究内容を見る</a>
      <a href="/ja/cv" class="btn btn-outline ml-5">CVを見る</a>
    </div>
  </div>

  <div>
    <div class="text-3xl w-full font-bold mb-2">主な研究・制作内容</div>
  </div>

  <HorizontalCard
    title="多言語 MLLM における忘却研究"
    img="/analysis.svg"
    desc="大規模マルチモーダルモデルにおける忘却挙動の多言語一貫性と信頼性に関する卒業研究。"
    url="/ja/projects"
    target="_self"
    badge="AI"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="生物統計学・因果推論"
    img="/research.svg"
    desc="標的試験エミュレーション、因果推論、リアルワールドデータ、臨床研究方法論への関心。"
    url="/ja/projects"
    target="_self"
    badge="Research"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="統計プログラミング・データ解析"
    img="/writing.svg"
    desc="Python、R、SAS、SQL を用いた統計解析、可視化、再現可能なレポート作成。"
    url="/ja/projects"
    target="_self"
    badge="Data"
  />

  <div>
    <div class="text-3xl w-full font-bold mb-5 mt-10">研究ノート</div>
  </div>

  {
    lastPosts.map((post) => {
      const copy = noteCopy[post.slug] ?? {
        title: post.data.title,
        description: post.data.description,
        badge: post.data.badge,
      };

      return (
        <>
          <HorizontalCard
            title={copy.title}
            img={post.data.heroImage}
            desc={copy.description}
            url={"/blog/" + createSlug(post.data.title, post.slug)}
            target="_self"
            badge={copy.badge}
          />
          <div class="divider my-0" />
        </>
      );
    })
  }
</BaseLayout>
