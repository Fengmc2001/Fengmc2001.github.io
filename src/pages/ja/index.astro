---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HorizontalCard from "../../components/HorizontalCard.astro";
import { getCollection } from "astro:content";
import createSlug from "../../lib/createSlug";

const posts = (await getCollection("blog")).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const lastPosts = posts.slice(0, 3);

const noteCopy: Record<string, { title: string; description: string; badge?: string }> = {
  "reproducible-analysis": {
    title: "再現可能なデータ解析のチェックリスト",
    description: "解析コード、表、図、報告書を検証可能な形で整理するための実践的なメモです。",
    badge: "データ解析",
  },
  "academic-writing": {
    title: "研究基盤としての学術的文章作成",
    description: "アウトライン、引用管理、LaTeX を用いて研究上の思考と修正過程を整理するための短い考察です。",
    badge: "学術文書",
  },
  "research-proposal": {
    title: "生物統計学の研究計画書をどのように構成するか",
    description: "臨床上の問いを、研究デザイン、仮定、解析計画、期待される貢献へと接続するためのメモです。",
    badge: "研究計画",
  },
};
---

<BaseLayout
  title="Fengmc | 生物統計学ポートフォリオ"
  description="生物統計学、臨床研究方法論、再現可能なデータ解析に関する個人ポートフォリオです。"
  sideBarActiveItemID="home"
  lang="ja"
>
  <div class="pb-12 mt-5">
    <div class="text-xl py-1">研究ポートフォリオ</div>
    <div class="text-5xl font-bold">Fengmc</div>
    <div class="text-3xl py-3 font-bold">生物統計学とデータ解析</div>
    <div class="py-2">
      <text class="text-lg">
        生物統計学、臨床研究方法論、因果推論、再現可能なデータ解析を中心に、研究上の問いを
        適切な研究デザインと統計解析へ結びつけることに関心があります。
        本サイトでは、研究プロフィール、学術的な文章、研究計画、解析プロジェクトを整理しています。
      </text>
    </div>
    <div class="mt-8">
      <a class="btn" href="/ja/projects">研究内容を見る</a>
      <a href="/ja/cv" class="btn btn-outline ml-5">CVを見る</a>
    </div>
  </div>

  <div>
    <div class="text-3xl w-full font-bold mb-2">主な研究・制作内容</div>
  </div>

  <HorizontalCard
    title="生物統計学に関する研究計画"
    img="/research.svg"
    desc="臨床研究の方法論、研究デザイン、統計的推論を中心に構成した研究計画の項目です。"
    url="/ja/projects"
    target="_self"
    badge="研究"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="臨床データ解析ワークフロー"
    img="/analysis.svg"
    desc="臨床・生物医学データの前処理、モデリング、可視化、報告を再現可能な形で進めるためのワークフローです。"
    url="/ja/projects"
    target="_self"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="学術文書・研究計画書"
    img="/writing.svg"
    desc="LaTeX を用いた研究計画、技術メモ、構造化された学術的文章のサンプルです。"
    url="/ja/projects"
    target="_self"
    badge="文章"
  />

  <div>
    <div class="text-3xl w-full font-bold mb-5 mt-10">研究ノート</div>
  </div>

  {
    lastPosts.map((post) => {
      const copy = noteCopy[post.slug] ?? {
        title: post.data.title,
        description: post.data.description,
        badge: post.data.badge,
      };

      return (
        <>
          <HorizontalCard
            title={copy.title}
            img={post.data.heroImage}
            desc={copy.description}
            url={"/blog/" + createSlug(post.data.title, post.slug)}
            target="_self"
            badge={copy.badge}
          />
          <div class="divider my-0" />
        </>
      );
    })
  }
</BaseLayout>
