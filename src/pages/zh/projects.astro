---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HorizontalCard from "../../components/HorizontalCard.astro";
---

<BaseLayout
  title="研究与项目"
  description="围绕生物统计学、临床研究方法学和可复现数据分析的研究与项目内容。"
  sideBarActiveItemID="projects"
  lang="zh-CN"
>
  <div>
    <div class="text-3xl w-full font-bold mb-5">研究与数据分析</div>
  </div>

  <HorizontalCard
    title="生物统计学研究计划"
    img="/research.svg"
    desc="用于整理研究背景、临床意义、研究方法、预期贡献和参考文献的研究计划项目。"
    url="#"
    badge="研究"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="临床数据分析流程"
    img="/analysis.svg"
    desc="涵盖统计编程、数据清洗、模型构建、结果可视化和可复现报告的项目页面。"
    url="#"
    badge="数据"
  />

  <div>
    <div class="text-3xl w-full font-bold mb-5 mt-10">学术写作与研究沟通</div>
  </div>

  <HorizontalCard
    title="学术写作样例"
    img="/writing.svg"
    desc="展示如何组织研究问题、方法、证据和论证结构的写作样例。"
    url="#"
    badge="写作"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="文献与参考资料笔记"
    img="/writing.svg"
    desc="围绕研究论文、统计方法学和相关生物医学证据整理的结构化笔记。"
    url="#"
    badge="笔记"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="个人主页后续规划"
    img="/analysis.svg"
    desc="后续用于加入公开代码仓库、数据集和交互式分析报告等内容的占位项目。"
    url="#"
  />
</BaseLayout>
