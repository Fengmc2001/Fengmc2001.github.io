---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HorizontalCard from "../../components/HorizontalCard.astro";
import { getCollection } from "astro:content";
import createSlug from "../../lib/createSlug";

const posts = (await getCollection("blog")).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const lastPosts = posts.slice(0, 3);

const noteCopy: Record<string, { title: string; description: string; badge?: string }> = {
  "reproducible-analysis": {
    title: "可复现数据分析检查清单",
    description: "关于如何组织分析代码、表格、图形和报告，使研究结果便于核查与复用的实践性笔记。",
    badge: "数据分析",
  },
  "academic-writing": {
    title: "作为研究基础设施的学术写作",
    description: "关于如何使用提纲、文献引用和 LaTeX 文档，使研究思路更易修订和追踪的简短思考。",
    badge: "学术写作",
  },
  "research-proposal": {
    title: "如何构建生物统计学研究计划",
    description: "关于如何将临床问题转化为研究设计、统计假设、分析计划和预期贡献的研究笔记。",
    badge: "研究计划",
  },
};
---

<BaseLayout
  title="Ziyin Wu | AI、生物统计与数据科学"
  description="吴子吟的个人学术主页，方向包括 AI、多语言 MLLM 忘却、生物统计、因果推断、真实世界数据和可重复数据分析。"
  sideBarActiveItemID="home"
  lang="zh-CN"
>
  <div class="pb-12 mt-5 pt-4">
    <div class="text-2xl py-1 font-medium text-base-content/70 mb-2">我是</div>
    <div class="text-6xl md:text-[4.5rem] leading-none font-extrabold tracking-tight mb-4 flex items-end gap-1">
      <ruby>吴<rt class="text-xl md:text-2xl font-medium text-base-content/50 tracking-widest" style="padding-bottom: 0.2em; font-family: ui-sans-serif, system-ui, sans-serif;">WU</rt></ruby>
      <ruby>子<rt class="text-xl md:text-2xl font-medium text-base-content/50 tracking-widest" style="padding-bottom: 0.2em; font-family: ui-sans-serif, system-ui, sans-serif;">ZI</rt></ruby>
      <ruby>吟<rt class="text-xl md:text-2xl font-medium text-base-content/50 tracking-widest" style="padding-bottom: 0.2em; font-family: ui-sans-serif, system-ui, sans-serif;">YIN</rt></ruby>
    </div>
    <div class="text-2xl py-2 font-bold leading-snug">
      关注 AI、生物统计与数据科学的<br />
      信息工程专业本科生
    </div>
    <div class="py-2 space-y-3 text-base leading-relaxed">
      <p>
        我目前就读于东京理科大学工学部信息工程学科。
      </p>
      <p>
        我的兴趣以 AI 和机器学习为中心，也包括生物统计、因果推断、真实世界数据分析以及可重复的科学计算。
      </p>
      <p>
        当前的本科毕业研究关注多语言大规模多模态模型中的遗忘一致性。
      </p>
      <p>
        本网站用于整理我的学术背景、项目、研究笔记和 CV。
      </p>
    </div>
    <div class="mt-8">
      <a class="btn" href="/zh/projects">查看研究内容</a>
      <a href="/zh/cv" class="btn btn-outline ml-5">查看 CV</a>
    </div>
  </div>

  <div>
    <div class="text-2xl w-full font-bold mb-2">代表性内容</div>
  </div>

  <HorizontalCard
    title="多语言 MLLM 忘却研究"
    img="/analysis.svg"
    desc="围绕大规模多模态模型中跨语言一致性与可信遗忘行为展开的本科毕业研究。"
    url="/zh/projects"
    target="_self"
    badge="AI"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="生物统计与因果推断"
    img="/research.svg"
    desc="关注标的试验模拟、因果推断、真实世界数据和临床研究方法论。"
    url="/zh/projects"
    target="_self"
    badge="Research"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="统计编程与数据分析"
    img="/writing.svg"
    desc="使用 Python、R、SAS、SQL 进行统计分析、可视化和可重复报告。"
    url="/zh/projects"
    target="_self"
    badge="Data"
  />

  <div>
    <div class="text-2xl w-full font-bold mb-4 mt-8">研究笔记</div>
  </div>

  {
    lastPosts.map((post) => {
      const copy = noteCopy[post.slug] ?? {
        title: post.data.title,
        description: post.data.description,
        badge: post.data.badge,
      };

      return (
        <>
          <HorizontalCard
            title={copy.title}
            img={post.data.heroImage}
            desc={copy.description}
            url={"/blog/" + createSlug(post.data.title, post.slug)}
            target="_self"
            badge={copy.badge}
          />
          <div class="divider my-0" />
        </>
      );
    })
  }
</BaseLayout>
