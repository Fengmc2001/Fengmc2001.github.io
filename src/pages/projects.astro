---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
---

<BaseLayout title="Projects" sideBarActiveItemID="projects">
  <div>
    <div class="text-3xl w-full font-bold mb-5">Research and analysis</div>
  </div>

  <HorizontalCard
    title="Multilingual MLLM Unlearning"
    img="/analysis.svg"
    desc="Undergraduate research on cross-lingual consistency in unlearning for large multimodal models, with interest in trustworthy AI and model behavior analysis."
    url="/projects"
    target="_self"
    badge="AI"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Biostatistics Research Proposal"
    img="/research.svg"
    desc="Research planning around clinical research methodology, causal inference, target trial emulation, and real-world data analysis."
    url="/projects"
    target="_self"
    badge="Research"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Reproducible Data Analysis Workflow"
    img="/writing.svg"
    desc="Statistical programming practice using Python, R, SAS, SQL, visualization, and reproducible reporting."
    url="/projects"
    target="_self"
    badge="Data"
  />

  <div>
    <div class="text-3xl w-full font-bold mb-5 mt-10">Writing and notes</div>
  </div>

  <HorizontalCard
    title="Academic Writing Samples"
    img="/writing.svg"
    desc="Research plans, technical reports, and structured LaTeX documents focused on clear methodology and reproducibility."
    url="/projects"
    target="_self"
    badge="Writing"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Statistics, AI, and Biostatistics Notes"
    img="/research.svg"
    desc="Learning notes on statistics, machine learning, causal inference, statistical modeling, and biomedical research methodology."
    url="/projects"
    target="_self"
    badge="Notes"
  />
</BaseLayout>
