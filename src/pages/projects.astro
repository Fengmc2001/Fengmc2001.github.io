---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
---

<BaseLayout title = "Projects" sideBarActiveItemID="projects">
  <div>
    <div class="text-3xl w-full font-bold mb-5">Research and analysis</div>
  </div>

  <HorizontalCard
    title="Biostatistics Research Proposal"
    img="/research.svg"
    desc="A proposal portfolio item for biostatistics, including study motivation, methods, expected contribution, and references."
    url="#"
    badge="Research"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Clinical Data Analysis Workflow"
    img="/analysis.svg"
    desc="A project page for statistical programming, data cleaning, modeling, visualization, and reproducible reporting."
    url="#"
    badge="Data"
  />

  <div>
    <div class="text-3xl w-full font-bold mb-5 mt-10">Writing and communication</div>
  </div>

  <HorizontalCard
    title="Academic Writing Samples"
    img="/writing.svg"
    desc="Selected writing samples that show how I organize research questions, methods, evidence, and argumentation."
    url="#"
    badge="Writing"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Literature and Reference Notes"
    img="/writing.svg"
    desc="Structured notes on research papers, statistical methodology, and related biomedical evidence."
    url="#"
    badge="Notes"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Portfolio Roadmap"
    img="/analysis.svg"
    desc="A placeholder for future projects, including public code repositories, datasets, and interactive reports."
    url="#"
  />
</BaseLayout>
