---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import { getCollection } from "astro:content";
import { workCard, worksBySection, workSectionTitles, type WorkSection } from "../lib/works";

const locale = "en";
const works = await getCollection("works");
const sections: WorkSection[] = ["research", "writing"];
const headingClass: Record<WorkSection, string> = {
  research: "text-3xl w-full font-bold mb-5",
  writing: "text-3xl w-full font-bold mb-5 mt-10",
};
---

<BaseLayout title="Projects" sideBarActiveItemID="projects" showParticles={false}>
  {
    sections.map((section) => (
      <>
        <div>
          <div class={headingClass[section]}>{workSectionTitles[locale][section]}</div>
        </div>

        {worksBySection(works, locale, section).map((work) => {
          const card = workCard(work, locale);

          return (
            <>
              <HorizontalCard
                title={card.title}
                img={card.img}
                desc={card.desc}
                url={card.url}
                target="_self"
                badge={card.badge}
              />
              <div class="divider my-0" />
            </>
          );
        })}
      </>
    ))
  }
</BaseLayout>
